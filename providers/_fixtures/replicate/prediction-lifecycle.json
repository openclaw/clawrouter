{
  "protocol": "replicate.predictions",
  "synthetic": true,
  "sources": [
    "https://replicate.com/docs/reference/http",
    "https://replicate.com/docs/topics/predictions/lifecycle",
    "https://replicate.com/docs/topics/predictions/data-retention",
    "https://replicate.com/docs/topics/billing"
  ],
  "request": {
    "method": "POST",
    "path": "/v1/predictions",
    "headers": {
      "Content-Type": "application/json",
      "Cancel-After": "600s"
    },
    "body": {
      "version": "1111111111111111111111111111111111111111111111111111111111111111",
      "input": {
        "prompt": "A synthetic blue square"
      }
    }
  },
  "controls": {
    "get": {
      "method": "GET",
      "path": "/v1/predictions/prediction_fixture_001"
    },
    "cancel": {
      "method": "POST",
      "path": "/v1/predictions/prediction_fixture_001/cancel"
    }
  },
  "retention": {
    "apiContentDefaultSeconds": 3600,
    "routerObservationWindowSeconds": 3600,
    "ownershipExpiryMeans": "deny controls; never release a scoped ID into unscoped pass-through"
  },
  "billing": {
    "basis": "policy_fixed",
    "fixturePolicyRequestMicrousd": 700,
    "actualProviderCostMicrousd": null,
    "predictTimeIsNotMoney": true,
    "cancelAfterIsNotUniversalCostBound": true,
    "unknownHardBudgetExpected": "pricing_required before upstream fetch"
  },
  "responses": {
    "created": {
      "id": "prediction_fixture_001",
      "version": "1111111111111111111111111111111111111111111111111111111111111111",
      "status": "starting",
      "input": {
        "prompt": "A synthetic blue square"
      },
      "output": null,
      "error": null,
      "logs": "",
      "urls": {
        "get": "https://api.replicate.com/v1/predictions/prediction_fixture_001",
        "cancel": "https://api.replicate.com/v1/predictions/prediction_fixture_001/cancel",
        "stream": "https://stream.replicate.com/v1/files/fixture"
      }
    },
    "partial": {
      "id": "prediction_fixture_001",
      "version": "1111111111111111111111111111111111111111111111111111111111111111",
      "status": "processing",
      "input": {
        "prompt": "A synthetic blue square"
      },
      "output": [
        "https://media.example/partial.png"
      ],
      "error": null,
      "logs": "",
      "urls": {
        "get": "https://api.replicate.com/v1/predictions/prediction_fixture_001",
        "cancel": "https://api.replicate.com/v1/predictions/prediction_fixture_001/cancel",
        "stream": "https://stream.replicate.com/v1/files/fixture"
      }
    },
    "succeeded": {
      "id": "prediction_fixture_001",
