  "acceptanceScenarios": [
    {
      "name": "partial-output",
      "observations": [
        "created",
        "partial",
        "succeeded",
        "succeeded"
      ],
      "expected": "starting/processing stay open; duplicate succeeded produces one frozen receipt"
    },
    {
      "name": "immediate-terminal-create",
      "observations": [
        "succeeded"
      ],
      "expected": "bind ID before returning bytes, settle once"
    },
    {
      "name": "cancel-ack",
      "observations": [
        "cancelAcknowledgedButOpen",
        "canceled"
      ],
      "expected": "POST acknowledgement stays open until a matching terminal object is observed; no free-charge inference"
    },
    {
      "name": "cancel-success-race",
      "observations": [
        "succeeded",
        "canceled"
      ],
      "expected": "first committed terminal receipt stays immutable"
    },
    {
      "name": "uncertain-cancel",
      "observations": [
        "partial",
        "succeeded"
      ],
      "expected": "GET original scoped job before any further cancel attempt"
    },
    {
      "name": "lost-create-response",
      "expected": "submission_unknown; persist recovery locator and conservative accounting; never replay upstream POST"
    },
    {
      "name": "same-idempotency-key",
      "expected": "one create sender, same digest reuses job, changed digest returns 409"
    },
    {
      "name": "owner-bound-controls",
      "expected": "cross-caller/tenant/policy, changed credential lineage, unknown ID and expired binding fail before upstream fetch"
    },
    {
      "name": "disconnect-restart",
      "expected": "delivery may end; observation and fenced outbox settlement survive restart"
    },
    {
      "name": "lost-settlement-ack",
      "expected": "retry same frozen receipt; independent settlement and usage ACKs prevent double charge"
    },
    {
      "name": "unresolved-evidence",
      "expected": "404, transport error, malformed/truncated/oversized JSON, unsupported status and ID mismatch are not terminal; retain conservative accounting"
    },
    {
      "name": "content-retention",
      "observations": [
        "dataRemoved"
      ],
      "expected": "removed output is not a billing refund or permission to forget ownership"
    }
  ]
}
