{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.ai/schemas/clawrouter/service-provider.v1.json",
  "title": "ClawRouter Service Provider Manifest",
  "type": "object",
  "required": ["schema", "id", "displayName", "auth", "baseUrls", "capabilities", "endpoints"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "clawrouter.service-provider.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["experimental", "stable", "deprecated", "disabled"] },
    "class": {
      "enum": [
        "openai_compatible",
        "anthropic_compatible",
        "rest_json",
        "rest_form",
        "oauth_rest_json",
        "cloudflare_ai_gateway",
        "custom_adapter"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string" },
        "kind": {
          "enum": [
            "api_provider",
            "model_provider",
            "tool_provider",
            "oauth_platform",
            "metering_platform",
            "gateway_platform"
          ]
        },
        "upstreamService": { "type": "string" },
        "oauthProvider": { "type": "string" },
        "configKeys": { "type": "array", "items": { "type": "string" } },
        "optionalConfigKeys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auth": {
      "type": "object",
      "required": ["schemes"],
      "additionalProperties": false,
      "properties": {
        "schemes": {
          "type": "array",
          "items": { "$ref": "#/$defs/authScheme" },
          "minItems": 1
        },
        "authorization": {
          "$ref": "#/$defs/authAuthorization"
        },
        "refresh": {
          "$ref": "#/$defs/authRefresh"
        },
        "grantTransports": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/grantTransport" }
        }
      }
    },
    "baseUrls": {
      "type": "object",
      "required": ["default"],
      "additionalProperties": { "type": "string" }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nativePrefixes": { "type": "array", "items": { "type": "string" } },
        "modelPrefixes": { "type": "array", "items": { "type": "string" } },
        "baseUrlParam": { "type": "string" },
        "serviceParam": { "type": "string" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": { "type": "string" },
        "response": { "type": "string" },
        "stream": { "type": "string" },
        "error": { "type": "string" },
        "passthroughHeaders": { "type": "array", "items": { "type": "string" } },
        "injectHeaders": { "type": "object", "additionalProperties": { "type": "string" } },
        "injectQuery": { "type": "object", "additionalProperties": { "type": "string" } },
        "requestTransforms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "renameFields": {
              "type": "array",
              "items": { "$ref": "#/$defs/fieldRenameTransform" }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "minItems": 1
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/endpoint" },
      "minProperties": 1
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/model" }
        }
      }
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "meter": { "type": "string" },
        "dimensions": { "type": "array", "items": { "type": "string" } },
        "counters": {
          "type": "array",
          "items": { "$ref": "#/$defs/meterCounter" }
        }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "responseHeaders": {
          "type": "array",
          "items": { "$ref": "#/$defs/quotaHeaderWindow" },
          "maxItems": 12
        },
        "probes": {
          "type": "array",
          "items": { "$ref": "#/$defs/quotaProbe" },
          "maxItems": 4
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixture" }
        }
      }
    }
  },
  "$defs": {
    "quotaWindowBase": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "kind": { "enum": ["requests", "tokens", "input_tokens", "output_tokens", "credits", "subscription", "generic"] },
        "unit": { "type": "string" },
        "window": { "type": "string" },
        "fixedLimit": { "type": "number", "minimum": 0 },
        "metricScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 }
      }
    },
    "quotaHeaderWindow": {
      "allOf": [
        { "$ref": "#/$defs/quotaWindowBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": true,
            "kind": true,
            "unit": true,
            "window": true,
            "fixedLimit": true,
            "metricScale": true,
            "limitHeaders": { "type": "array", "items": { "type": "string" } },
            "remainingHeaders": { "type": "array", "items": { "type": "string" } },
            "usedHeaders": { "type": "array", "items": { "type": "string" } },
            "resetHeaders": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
      "quotaProbeWindow": {
        "allOf": [
          {
            "$ref": "#/$defs/quotaWindowBase"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": true,
              "kind": true,
              "unit": true,
              "window": true,
              "fixedLimit": true,
              "metricScale": true,
              "limitPointer": {
                "type": "string",
                "pattern": "^/"
              },
              "remainingPointer": {
                "type": "string",
                "pattern": "^/"
              },
              "usedPointer": {
                "type": "string",
                "pattern": "^/"
              },
              "resetPointer": {
                "type": "string",
                "pattern": "^/"
              },
              "models": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
                }
              },
              "collection": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pointer",
                  "filter",
                  "modelPointer"
                ],
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "filter": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "pointer",
                      "equals"
                    ],
                    "properties": {
                      "pointer": {
                        "type": "string",
                        "pattern": "^/"
                      },
                      "equals": {
                        "type": "string"
                      }
                    }
                  },
                  "modelPointer": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            }
          }
        ]
      },
      "quotaProbe": {
        "type": "object",
        "required": [
          "grantKinds",
          "url",
          "windows"
        ],
        "additionalProperties": false,
        "properties": {
          "grantKinds": {
            "type": "array",
            "items": {
              "enum": [
                "api_key",
                "oauth",
                "subscription"
              ]
            },
            "minItems": 1
          },
          "requiresRefreshToken": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "windows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/quotaProbeWindow"
            },
            "minItems": 0,
            "maxItems": 12
          },
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "account": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "displayName": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "rateLimitTier": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "subscriptionStatus": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "extraUsageEnabled": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              },
              "extraUsage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "usedCredits": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "monthlyLimit": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "utilization": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^/"
                  },
                  "spendLimitReached": {
                    "type": "string",
                    "pattern": "^/"
                  }
                }
              }
            }
          }
        }
      },
    "authAuthorization": {
      "type": "object",
      "required": ["authorizeUrl", "tokenUrl", "scopes"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["clientId"] },
        { "required": ["clientIdConfig"] }
      ],
      "properties": {
        "authorizeUrl": { "type": "string", "pattern": "^https://" },
        "tokenUrl": { "type": "string", "pattern": "^https://" },
        "clientId": { "type": "string" },
        "clientIdConfig": { "type": "string" },
        "clientSecretConfig": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "grantKind": { "enum": ["oauth", "subscription"] },
        "extraAuthorizeParams": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "extraTokenParams": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "accountIdJsonPointer": { "type": "string", "pattern": "^/" },
        "subscriptionPlanJsonPointer": { "type": "string", "pattern": "^/" }
      }
    },
    "authRefresh": {
      "type": "object",
      "required": ["tokenUrl"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["clientId"] },
        { "required": ["clientIdConfig"] }
      ],
      "properties": {
        "tokenUrl": { "type": "string", "pattern": "^https://" },
        "clientId": { "type": "string" },
        "clientIdConfig": { "type": "string" },
        "clientSecretConfig": { "type": "string" },
        "requestFormat": { "enum": ["form", "json"] },
        "extraParams": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "grantTransport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^https://" },
        "auth": { "$ref": "#/$defs/grantTransportAuth" },
        "allowedEndpoints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "endpointPaths": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^/" }
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "appendHeaders": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "requestTransforms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prependSystem": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "text"],
                "properties": {
                  "type": { "const": "text" },
                  "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
                }
              },
              "maxItems": 8
            }
          }
        },
        "maintenance": { "$ref": "#/$defs/grantTransportMaintenance" }
      }
    },
    "grantTransportAuth": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "header", "format"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "bearer" },
            "header": { "type": "string" },
            "format": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "header"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "api_key" },
            "header": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "param"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "query_api_key" },
            "param": { "type": "string" }
          }
        }
      ]
    },
    "grantTransportMaintenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quotaPoll": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalIntervalSeconds", "urgentIntervalSeconds", "exhaustedIntervalSeconds", "urgentRemainingPercent"],
          "properties": {
            "normalIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "urgentIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "exhaustedIntervalSeconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
            "urgentRemainingPercent": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "keepWarm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intervalSeconds", "endpoint", "body"],
          "properties": {
            "defaultEnabled": { "type": "boolean", "default": false },
            "intervalSeconds": { "type": "integer", "minimum": 3600, "maximum": 86400 },
            "endpoint": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
            "body": { "type": "object" }
          }
        }
      }
    },
    "authScheme": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "header", "format", "secretKind"],
          "properties": {
            "type": { "const": "bearer" },
            "header": { "type": "string" },
            "format": { "type": "string" },
            "secretKind": { "type": "string" },
            "required": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "header", "secretKind"],
          "properties": {
            "type": { "const": "api_key" },
            "header": { "type": "string" },
            "secretKind": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "param", "secretKind"],
          "properties": {
            "type": { "const": "query_api_key" },
            "param": { "type": "string" },
            "secretKind": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "scopes"],
          "properties": {
            "type": { "const": "oauth" },
            "provider": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } },
            "tokenRef": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "service"],
          "properties": {
            "type": { "const": "sig_v4" },
            "service": { "type": "string" },
            "regionParam": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "cloudflare_binding" }
          },
          "additionalProperties": false
        }
      ]
    },
    "capability": {
      "type": "object",
      "required": ["id", "endpoint"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "endpoint": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" } }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["path", "requestFormat", "responseFormat"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "method": { "type": "string" },
        "nativeProxy": { "type": "boolean" },
        "auth": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "requestHeaders": { "type": "array", "items": { "type": "string" } },
        "responseHeaders": { "type": "array", "items": { "type": "string" } },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "pathParams": { "type": "array", "items": { "type": "string" } },
        "pathParamStyles": {
          "type": "object",
          "additionalProperties": { "enum": ["segment", "opaque_segment", "relative_path"] }
        },
        "requestFormat": { "type": "string" },
        "responseFormat": { "type": "string" },
        "streaming": { "type": "string" },
        "responsesLifecycle": {
          "type": "object",
          "required": ["retrieve", "cancel"],
          "additionalProperties": false,
          "properties": {
            "retrieve": { "type": "string", "minLength": 1, "maxLength": 64 },
            "cancel": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        },
        "outputTokenLimit": {
          "type": "object",
          "required": ["field", "minimum", "maximum"],
          "additionalProperties": false,
          "properties": {
            "field": { "enum": ["max_tokens", "max_completion_tokens", "max_output_tokens"] },
            "minimum": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "maximum": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        "modelPassthrough": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "pricingRef": { "type": "string", "minLength": 1 } }
        },
        "websocket": { "enum": ["openai.responses"] },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "upstream"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "upstream": { "type": "string" },
        "codexModel": { "type": "string", "minLength": 1 },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "supportedReasoningEfforts": {
          "type": "array",
          "items": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true
        },
        "requestParameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/modelRequestParameters" }
        },
        "nativeCapabilities": { "$ref": "#/$defs/nativeModelCapabilities" },
        "pricingRef": { "type": "string" },
        "pricing": { "$ref": "#/$defs/modelPricing" }
      }
    },
    "nativeModelCapabilities": {
      "type": "object",
      "required": [
        "version",
        "endpoints"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "clawrouter.native-capabilities.v1"
        },
        "endpoints": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/nativeEndpointCapabilities"
          }
        }
      }
    },
    "nativeEndpointCapabilities": {
      "type": "object",
      "required": [
        "sources",
        "checkedAt"
      ],
      "minProperties": 3,
      "additionalProperties": false,
      "properties": {
        "sources": {
          "$ref": "#/$defs/modelRequestParameters/properties/sources"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "json"
            ]
          }
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hostedTools": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "web_search" } },
        "supportedServiceTiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "inference": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "chat": {
              "type": "boolean"
            },
            "decision": {
              "$ref": "#/$defs/nativeDecisionCapabilities"
            }
          }
        }
      }
    },
    "nativeDecisionCapabilities": {
      "type": "object",
      "required": [
        "protocol",
        "questions",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "openai-decisions"
        },
        "reasoning": {
          "type": "object",
          "required": [
            "modes"
          ],
          "additionalProperties": false,
          "properties": {
            "modes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "const": "auto"
              }
            }
          }
        },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "boolean": {
              "$ref": "#/$defs/nativeBooleanQuestion"
            },
            "choice": {
              "type": "object",
              "required": [
                "probabilities",
                "abstention",
                "minOptions",
                "maxOptions"
              ],
              "additionalProperties": false,
              "properties": {
                "probabilities": {
                  "const": "categorical"
                },
                "abstention": {
                  "type": "boolean"
                },
                "minOptions": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 255
                },
                "maxOptions": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 255
                }
              }
            },
            "score": {
              "type": "object",
              "required": [
                "probabilities",
                "abstention"
              ],
              "additionalProperties": false,
              "properties": {
                "probabilities": {
                  "const": "categorical"
                },
                "abstention": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "confidence": {
          "const": "provider-specific"
        },
        "limits": {
          "type": "object",
          "required": [
            "maxQuestions"
          ],
          "additionalProperties": false,
          "properties": {
            "maxQuestions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "image": {
              "type": "object",
              "required": [
                "maxBytes",
                "mimeTypes",
                "remoteUrls"
              ],
              "additionalProperties": false,
              "properties": {
                "maxBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4194304
                },
                "mimeTypes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "image/png",
                      "image/jpeg",
                      "image/webp"
                    ]
                  }
                },
                "remoteUrls": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "nativeBooleanQuestion": {
      "type": "object",
      "required": [
        "probabilities",
        "abstention"
      ],
      "additionalProperties": false,
      "properties": {
        "probabilities": {
          "const": "boolean"
        },
        "abstention": {
          "type": "boolean"
        }
      }
    },
    "parameterSupport": { "enum": ["supported", "unsupported", "requires_reasoning_none"] },
    "modelRequestParameters": {
      "type": "object",
      "required": ["sources", "checkedAt"],
      "additionalProperties": false,
      "properties": {
        "sources": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://" } },
        "checkedAt": { "type": "string", "format": "date" },
        "defaultReasoningEffort": { "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"] },
        "temperature": { "$ref": "#/$defs/parameterSupport" },
        "topP": { "$ref": "#/$defs/parameterSupport" },
        "logprobs": { "$ref": "#/$defs/parameterSupport" },
        "toolCalling": { "$ref": "#/$defs/parameterSupport" }
      }
    },
    "modelPricing": {
      "oneOf": [{ "$ref": "#/$defs/tokenPricing" }, { "$ref": "#/$defs/characterPricing" }, { "$ref": "#/$defs/imageTokenPricing" }]
    },
    "imageTokenPricing": {
      "type": "object",
      "required": [
        "unit",
        "effectiveAt",
        "source",
        "textInputMicrosPerMillion",
        "imageInputMicrosPerMillion",
        "imageOutputMicrosPerMillion",
        "generation"
      ],
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "image_token"
        },
        "effectiveAt": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "type": "string",
          "pattern": "^https://"
        },
        "textInputMicrosPerMillion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imageInputMicrosPerMillion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imageOutputMicrosPerMillion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "object",
          "required": [
            "source",
            "checkedAt",
            "maxPromptCharacters",
            "maxImages",
            "dimensionMultiple",
            "minPixels",
            "maxPixels",
            "maxEdge",
            "maxAspectRatio",
            "outputTokenBound"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^https://"
            },
            "checkedAt": {
              "type": "string",
              "format": "date"
            },
            "maxPromptCharacters": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32000
            },
            "maxImages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "dimensionMultiple": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "minPixels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8294400
            },
            "maxPixels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8294400
            },
            "maxEdge": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3840
            },
            "maxAspectRatio": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "outputTokenBound": {
              "type": "object",
              "required": [
                "basePixels",
                "divisor",
                "qualityFactors"
              ],
              "additionalProperties": false,
              "properties": {
                "basePixels": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "divisor": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000
                },
                "qualityFactors": {
                  "type": "object",
                  "required": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "low": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "medium": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "high": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "xhigh": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1024
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "characterPricing": {
      "type": "object",
      "required": ["unit", "effectiveAt", "source", "inputMicrosPerMillionCharacters", "maxInputCharacters"],
      "additionalProperties": false,
      "properties": {
        "unit": { "const": "character" },
        "effectiveAt": { "type": "string", "format": "date" },
        "source": { "type": "string", "pattern": "^https://" },
        "inputMicrosPerMillionCharacters": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxInputCharacters": { "const": 4096 }
      }
    },
    "tokenPricing": {
      "type": "object",
      "required": [
        "effectiveAt",
        "source",
        "inputMicrosPerMillion",
        "outputMicrosPerMillion",
        "maxInputTokens",
        "defaultMaxOutputTokens"
      ],
      "additionalProperties": false,
      "properties": {
        "effectiveAt": { "type": "string", "format": "date" },
        "source": { "type": "string", "pattern": "^https://" },
        "inputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "outputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cachedInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWriteInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWrite5mInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWrite1hInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxInputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "maxRequestInputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "defaultMaxOutputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "inputTokenOverhead": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "unpricedCosts": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "enum": ["request_fee"] } },
        "settlementBasis": { "enum": ["published_upper_bound"] },
        "longContext": { "$ref": "#/$defs/longContextPricing" },
        "serviceTiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/serviceTierPricing" }
        }
      }
    },
    "serviceTierPricing": {
      "type": "object",
      "required": ["id", "inputMicrosPerMillion", "outputMicrosPerMillion"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "aliases": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" } },
        "inputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "outputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cachedInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWriteInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWrite5mInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWrite1hInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "maxInputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "longContext": { "$ref": "#/$defs/longContextPricing" }
      }
    },
    "longContextPricing": {
      "type": "object",
      "required": [
        "thresholdInputTokens",
        "inputMicrosPerMillion",
        "outputMicrosPerMillion"
      ],
      "additionalProperties": false,
      "properties": {
        "thresholdInputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "inputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "outputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cachedInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWriteInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWrite5mInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cacheWrite1hInputMicrosPerMillion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "meterCounter": {
      "type": "object",
      "required": ["name", "source"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "fieldRenameTransform": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "upstreams": { "type": "array", "items": { "type": "string" } },
        "upstreamConfig": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["name", "request", "response"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "request": { "type": "string" },
        "response": { "type": "string" }
      }
    }
  }
}
